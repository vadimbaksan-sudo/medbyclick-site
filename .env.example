# MedByClick — environment variables
#
# Copy to .env.local for local development (bun dev reads .env.local
# automatically). None of these are set in the sandbox this code was written
# in — see the Developer role's summary for what Vadim needs to supply
# before auth, the database, or Stripe payments work live.

# --- Supabase (Auth + Postgres) -------------------------------------------
# From a real Supabase project: Project Settings → API.
# NEXT_PUBLIC_ prefix is required because the anon key is safe to expose to
# the browser (it's rate-limited and governed by Row Level Security) and the
# browser Supabase client needs it directly.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — bypasses Row Level Security. Server-only, never
# NEXT_PUBLIC_-prefixed. Not required by any current code path in this repo
# (Drizzle connects directly to Postgres via DATABASE_URL below, which
# already runs with elevated privileges), but Supabase provisions one per
# project and some future admin-only operations (e.g. the Admin API) will
# need it — capturing the env var name now.
SUPABASE_SERVICE_ROLE_KEY=

# Drizzle ORM's Postgres connection string — from the same Supabase project:
# Project Settings → Database → Connection string. Use the "Transaction"
# pooler string (port 6543) for serverless/Vercel deployments; lib/db/client.ts
# sets `prepare: false` to support it.
DATABASE_URL=

# --- Stripe (test mode) -----------------------------------------------------
# Vadim needs to create a real MedByClick Stripe account (test mode is fine
# to start) — see Stripe Dashboard → Developers → API keys. The current
# hardcoded pk_test_TYooMQauvdEDq54NiTphI7jx in app/checkout/stripe was
# Stripe's own public demo key, not a real MedByClick account.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# From Stripe Dashboard → Developers → Webhooks, after registering
# app/api/payments/stripe/webhook as an endpoint (or `stripe listen` for
# local development).
STRIPE_WEBHOOK_SECRET=

# --- Existing (medai) --------------------------------------------------------
ANTHROPIC_API_KEY=
