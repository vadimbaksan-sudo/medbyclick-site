{
  "name": "mbc-token",
  "version": "2.0.0",
  "private": true,
  "description": "MBC dual-chain token: BNB Chain canonical ERC-20/BEP-20 (Contract A) + BNB Chain LayerZero OFT Adapter lock side (Contract C) + Ethereum-side LayerZero OFT mint/burn side (Contract B).",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:bnbtoken:testnet": "hardhat run scripts/deploy-bnb-token.ts --network bscTestnet",
    "deploy:bnbtoken:mainnet": "hardhat run scripts/deploy-bnb-token.ts --network bsc",
    "deploy:bnbadapter:testnet": "hardhat run scripts/deploy-bnb-adapter.ts --network bscTestnet",
    "deploy:bnbadapter:mainnet": "hardhat run scripts/deploy-bnb-adapter.ts --network bsc",
    "deploy:ethoft:sepolia": "hardhat run scripts/deploy-eth-oft.ts --network sepolia",
    "verify:bsc": "hardhat verify --network bsc",
    "verify:bscTestnet": "hardhat verify --network bscTestnet",
    "verify:sepolia": "hardhat verify --network sepolia"
  },
  "devDependencies": {
    "@layerzerolabs/lz-evm-messagelib-v2": "^3.0.168",
    "@layerzerolabs/lz-evm-protocol-v2": "^3.0.168",
    "@layerzerolabs/lz-evm-v1-0.7": "^3.0.168",
    "@layerzerolabs/lz-v2-utilities": "^3.0.168",
    "@layerzerolabs/oapp-evm": "^0.4.1",
    "@layerzerolabs/oft-evm": "^4.0.1",
    "@layerzerolabs/test-devtools-evm-hardhat": "^0.5.3",
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-ignition": "^0.15.16",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.17",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@nomicfoundation/ignition-core": "^0.15.15",
    "@openzeppelin/contracts": "^5.1.0",
    "@openzeppelin/contracts-upgradeable": "^5.6.1",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "chai": "^4.5.0",
    "dotenv": "^16.4.5",
    "ethers": "^6.17.0",
    "hardhat": "^2.22.0",
    "hardhat-gas-reporter": "^1.0.10",
    "solidity-bytes-utils": "^0.8.4",
    "solidity-coverage": "^0.8.17",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.5.0"
  }
}
