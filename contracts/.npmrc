# LayerZero's @layerzerolabs/oapp-evm has a hard (non-peer) dependency on
# ethers@^5, which conflicts with @nomicfoundation/hardhat-toolbox's ethers@^6
# peer requirement. Only LayerZero's own JS tooling (which we don't use here)
# needs ethers v5 — we only consume their Solidity source. legacy-peer-deps
# lets npm install both without failing the resolver; the two ethers copies
# never interact at runtime since we never import LayerZero's JS helpers that
# depend on v5.
legacy-peer-deps=true
