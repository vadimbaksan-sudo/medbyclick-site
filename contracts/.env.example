# Copy this file to contracts/.env and fill in real values. contracts/.env is
# gitignored (see .gitignore) — never commit real keys.

# Deployer key used for BOTH BNB Chain and Sepolia deploy scripts (testnet
# use only in this repo — see hardhat.config.ts for why there is no Ethereum
# mainnet network target here).
DEPLOYER_PRIVATE_KEY=

# Ethereum — Sepolia testnet ONLY.
SEPOLIA_RPC_URL=
ETHERSCAN_API_KEY=

# BNB Chain — mainnet and testnet.
BSC_MAINNET_RPC_URL=https://bsc-rpc.publicnode.com
BSC_TESTNET_RPC_URL=https://bsc-testnet-rpc.publicnode.com
BSCSCAN_API_KEY=

# Deploy-script inputs (see scripts/deploy-*.ts for which script needs which):
SAFE_ADDRESS=
MBC_TOKEN_ADDRESS=
LZ_ENDPOINT_ADDRESS=
DELEGATE_ADDRESS=
